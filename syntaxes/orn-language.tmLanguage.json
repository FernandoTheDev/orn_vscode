{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "orn-language",
	"scopeName": "source.orn",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#identifiers"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.orn-language",
				"match": "\\b(import|for|while|do|return|if|else|sizeof|struct|int|i32|long|i64|float|f32|double|f64|i1|u1|bool|char|string|void|uint|ulong|short|ushort|u8|i8|u32|u64|byte|ubyte|i16|u16|break|continue|enum|fn|let|const|from)\\b"
			}]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.orn-language",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "constant.language.null.orn-language",
					"match": "\\bnull\\b"
				}
			]
		},
		"strings": {
			"patterns": [{
				"name": "string.quoted.double.orn-language",
				"begin": "\"",
				"end": "\"",
				"patterns": [{
					"name": "constant.character.escape.orn-language",
					"match": "\\\\."
				}]
			},
			{
            	"name": "string.quoted.single.orn-language",
            	"begin": "'",
            	"end": "'",
            	"patterns": [{
            	    "name": "constant.character.escape.orn-language",
            	    "match": "\\\\."
            	}]
        	}
		]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.orn-language",
					"match": "//.*$"
				},
				{
					"name": "comment.line.hash.orn-language",
					"match": "#.*$"
				},
				{
					"name": "comment.block.orn-language",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"numbers": {
	    "patterns": [
	        	{
	        	    "name": "constant.numeric.binary.orn-language",
	        	    "match": "\\b0[bB][01](_?[01])*\\b"
	        	},
	        	{
	        	    "name": "constant.numeric.binary.suffix.orn-language",
	        	    "match": "\\b[01](_?[01])*b\\b"
	        	},
	        	{
	        	    "name": "constant.numeric.hex.orn-language",
	        	    "match": "\\b0[xX][0-9A-Fa-f](_?[0-9A-Fa-f])*\\b"
	        	},
	        	{
	        	    "name": "constant.numeric.decimal.orn-language",
	        	    "match": "\\b\\d+(_\\d+)*(\\.\\d+(_\\d+)*)?([LlDdFf])?\\b"
	        	}
	    	]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.orn-language",
					"match": "\\+|\\-|\\*|\\/|%"
				},
				{
					"name": "keyword.operator.comparison.orn-language",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.logical.orn-language",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.assignment.orn-language",
					"match": "=|\\+=|\\-=|\\*=|\\/=|%="
				},
				{
					"name": "keyword.operator.bitwise.orn-language",
					"match": "&|\\||\\^|~|<<|>>"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.orn-language",
					"match": ";"
				},
				{
					"name": "punctuation.separator.orn-language",
					"match": ","
				},
				{
					"name": "punctuation.accessor.orn-language",
					"match": "\\."
				},
				{
					"name": "punctuation.section.braces.orn-language",
					"match": "\\{|\\}"
				},
				{
					"name": "punctuation.section.brackets.orn-language",
					"match": "\\[|\\]"
				},
				{
					"name": "punctuation.section.parens.orn-language",
					"match": "\\(|\\)"
				}
			]
		},
		"functions": {
		    "patterns": [{
		        "name": "entity.name.function.orn-language",
		        "match": "(?<![a-zA-Z0-9_@])[@a-zA-Z_][@a-zA-Z0-9_]*\\s*(?=\\()"
		    }]
		},
		"identifiers": {
		    "patterns": [{
		        "name": "variable.other.orn-language",
		        "match": "(?<![a-zA-Z0-9_@])[@a-zA-Z_][@a-zA-Z0-9_]*(?![a-zA-Z0-9_@])"
		    }]
		}
	}
}
